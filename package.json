{
  "name": "writefix-ai",
  "version": "1.0.0",
  "description": "Instantly improve selected text anywhere on the web",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt --target firefox",
    "build": "vite build packages/web",
    "build:ext": "wxt build",
    "build:extension": "wxt build",
    "build:firefox": "wxt build --target firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip --target firefox",
    "dev:web": "vite packages/web",
    "build:web": "vite build packages/web",
    "preview:web": "vite preview packages/web",
    "compile": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@writefix/core": "*",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.7",
    "wxt": "^0.19.16",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@wxt-dev/module-react": "^1.1.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0-beta.8",
    "typescript": "^5.7.2"
  }
}
